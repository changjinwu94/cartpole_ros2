<?xml version="1.0"?>
<package format="3">
  <name>cartpole_hardware</name><version>0.2.0</version>
  <description>Cartpole sensor acquisition and guarded RS232 velocity control.</description>
  <maintainer email="maintainer@example.com">Cartpole project</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-serial</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
